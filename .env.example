# Sentry Auth Token (used during native builds to upload source maps)
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TURN relay credentials for remote connections (same values as the desktop
# JNBOT_TURN_USERNAME / JNBOT_TURN_CREDENTIAL). Without them only STUN is used.
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=

# Monetization environment: development, preview, or production
EXPO_PUBLIC_MONETIZATION_ENV=development

# Public legal & community links
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://jnbot.netlify.app/privacy
EXPO_PUBLIC_TERMS_OF_USE_URL=https://jnbot.netlify.app/eula
EXPO_PUBLIC_DISCORD_URL=https://discord.gg/JNbGgypERe
EXPO_PUBLIC_DESKTOP_DOWNLOAD_URL=https://jnbot.netlify.app/download

# Android AdMob app ID (read while Expo generates native projects)
# Development/preview may use Google's test App ID. Production values belong in EAS.
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx

# Android interstitial ad unit (embedded in the JavaScript bundle; this is public)
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# RevenueCat Test Store public SDK key (development/preview only)
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat Android public SDK key (production only)
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
