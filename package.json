{
  "name": "jnbot-mobile",
  "version": "3.2.5",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-nodejs-mobile.mjs && node scripts/patch-react-native-prebuilt.mjs && node scripts/patch-apple-targets.mjs",
    "verify:android-page-size": "node scripts/android-page-size.mjs android/app/build/outputs/bundle/release/app-release.aab",
    "verify:local-backend": "node scripts/verify-local-backend.mjs",
    "prebuild:native": "npm run verify:local-backend && expo prebuild",
    "start": "expo start",
    "start:expo-go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios:altstore": "node scripts/build-altstore.mjs",
    "release:ios": "npm run build:ios:altstore",
    "release:android": "node scripts/release-android.mjs",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "check:desktop-contract": "node ../app/scripts/sync-mobile-client-contract.mjs --check",
    "test": "jest --runInBand",
    "prepare:needle": "node ../app/scripts/prepare-needle-mobile.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "anser": "^2.3.5",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~58.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "jnbot-needle": "file:../app/native/needle",
    "nodejs-mobile-react-native": "^18.20.4",
    "prismjs": "^1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "16.0.3",
    "react-native-purchases": "^10.7.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/prebuild-config": "~54.0.9",
    "@types/jest": "29.5.14",
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  }
}
